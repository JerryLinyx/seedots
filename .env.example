# ---- 模型（OpenAI 兼容接口，经 TokenRouter）----
# 在 https://www.tokenrouter.com/console/token 创建密钥后填入；不要提交到仓库
SEEDOTS_LLM_API_KEY=
# 如果你的控制台给出的地址不同，以控制台为准
SEEDOTS_LLM_BASE_URL=https://api.tokenrouter.com/v1
SEEDOTS_LLM_MODEL=deepseek/deepseek-v4-flash-0731
# 没有密钥时设为 1：用离线假模型跑通流程（只用于开发）
SEEDOTS_LLM_FAKE=0
# 推理（思考）强度：auto = 按任务设置（动作选择、Coach 等要快的任务用 low，其余用模型默认）；
# off = 不发送该参数（服务商不支持时）；low / medium / high = 所有任务统一用这一档
SEEDOTS_LLM_REASONING=auto
# 按任务覆盖输出上限（思考 + 回答共用），例如 scene_code=48000,items=20000；留空用代码里的默认值
SEEDOTS_LLM_MAX_TOKENS=

# ---- 概念召回用的向量模型（可选；留空则用本地字面相似度兜底）----
SEEDOTS_EMBED_MODEL=
# SEEDOTS_EMBED_BASE_URL=   默认同 LLM
# SEEDOTS_EMBED_API_KEY=    默认同 LLM

# ---- 语音识别（可选；只在来源没有字幕时使用，OpenAI 兼容 /audio/transcriptions）----
SEEDOTS_ASR_MODEL=
# SEEDOTS_ASR_BASE_URL=
# SEEDOTS_ASR_API_KEY=

# ---- 交互场（L2）----
# 截图审查用的视觉模型（OpenAI 兼容，支持图片输入）；不配置时这一关会记为“跳过”
SEEDOTS_VLM_MODEL=
# SEEDOTS_VLM_BASE_URL=
# SEEDOTS_VLM_API_KEY=
# 生成代码在哪里跑：local = 本机无头 Chromium（services/scenekit，需 npm install）；off = 关闭 L2
SEEDOTS_SANDBOX=local
# 可选：指定浏览器路径（默认用已安装的 Google Chrome）
# SEEDOTS_CHROME=

# ---- 数据库（每个服务一个库；留空 = data/ 下的 SQLite）----
# 生产：postgresql+psycopg://user:pass@host/seedots_media
SEEDOTS_MEDIA_DB_URL=
SEEDOTS_LEARNING_DB_URL=
# 启动时自动执行 Alembic 迁移
SEEDOTS_AUTO_MIGRATE=1

# ---- 工作流引擎：inprocess（默认）或 temporal ----
SEEDOTS_WORKFLOW_ENGINE=inprocess
SEEDOTS_TEMPORAL_ADDRESS=127.0.0.1:7233

# ---- 服务地址 ----
SEEDOTS_MEDIA_URL=http://127.0.0.1:8001
SEEDOTS_LEARNING_URL=http://127.0.0.1:8000
# The rig service (services/rigs, Node 22.18+): checks lab specs and computes their facts.
SEEDOTS_RIGS_URL=http://127.0.0.1:8002
# 底座把事件推给学习后端的地址（启动时自动登记为订阅）
SEEDOTS_MEDIA_WEBHOOK_URL=http://127.0.0.1:8000/hooks/media
# 底座与学习后端之间的共享签名密钥（随便一串字符即可）
SEEDOTS_WEBHOOK_SECRET=change-me

# ---- 数据目录（SQLite、上传文件、关键帧）----
SEEDOTS_DATA_DIR=./data

# ---- 网页视频抓取（services/grabber，需要 Node 20+；在该目录 npm install）----
# SEEDOTS_GRABBER_DIR=

# ---- 动作选择：rule 或 llm（llm 出错时自动回退规则）----
SEEDOTS_ACTION_SELECTOR=llm

# ---- 前端 ----
# 允许访问学习后端的前端地址（CORS）
SEEDOTS_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
